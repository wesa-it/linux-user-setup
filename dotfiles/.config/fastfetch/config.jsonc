//  | |___| | | | (_| |  __| (_| |\ V | (_) | |_| | |  | |_| |___) |
//  |_____|_| |_|\__,_|\___|\__,_| \_/ \___/ \__,_|_|   \___/|____/
//  |  _____ _ ___| |_ / _| ___| |_ ___| |__
//  | |_ / _` / __| __| |_ / _ | __/ __| '_ \
//  |  _| (_| \__ | |_|  _|  __| || (__| | | |
//  |_|  \__,_|___/\__|_|  \___|\__\___|_| |_|
//
// Inspired by many at EndeavourOS Forum and cobbled together by Noodly

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    //"logo": {
    //    "type": "auto",
    //    "source":  "/home/joshua/Dokumente/Fastfetch EnOS Fastfetch Logos/EnOS Noodly Catppuccin ENLogo Textured Shadow.png",
    //    "height": 30,
    //      "padding": {
    //         "top": 12,
    //         "left": 2,
    //         "right": 2
    //    }
    //},
    "display": {
        "color": {
            "keys": "blue"
        },
        "separator": "",
        "constants": [
            "──────────────────────────────────────────────────────",   // {$1} - horizontal line for borders
            "\u001b[55D",                                               // {$2} - move cursor left 55 columns
            "\u001b[55C",                                               // {$3} - move cursor right 55 columns
            "\u001b[54C"                                                // {$4} - move cursor right 54 columns
        ],
        "brightColor": false,
        "bar": {
            "width": 10,       // Width of percentage bars
            "border": {
                "left":"",
                "right": ""
            },
            "char": {
                "elapsed": "●", // Character for elapsed portion
                // "elapsed": "■", // Character for elapsed portion
                "total": ""    // Character for total portion
            }
        },
        "percent": {
            "type": 9,         // 1=number, 2=bar, 3=both, 9=colored number
            "color": {
                "green": "green",
                "yellow": "light_yellow",
                "red": "light_red"
            }
        }
    },    "modules": [
    "break",
        {
            "type": "custom",
            "key": "                            {#31} F {#32}A {#33}S {#34}T {#35}F {#36}E {#37}T {#31}C {#32}H "
        },
        "break",
        {
            "type": "custom",
            "key": " {#36}┌─────────────┬{$1}┐{#keys} \u001b[37D",
            "format": ""
        },
        {
            "type": "os",
            "key": " {#36}│{#36} OS          {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "kernel",
            "key": " {#36}│{#36} Kernel      {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "de",
            "key": " {#36}│{#36} Desktop     {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "wm",
            "key": " {#36}│{#36} Session     {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "packages",
            "key": " {#36}│{#36} Packages    {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "processes",
            "key": " {#36}│{#36} Processes   {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "custom",
            "key": " {#36}└─────────────┴{$1}┘{#keys} ",
            "format": ""
        },
        {
            "type": "custom",
            "key": " {#36}┌─────────────┬{$1}┐{#keys} \u001b[37D",
            "format": ""
        },
        {
            "type": "host",
            "key": " {#36}│{#36} Machine     {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "display",
            "key": " {#36}│{#36} Monitor     {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "cpu",
            "key": " {#36}│{#36} CPU         {#36}│{$4}│{#keys} {$2}",
            "format": "{name} @{freq-max}",
            "showPeCoreCount": false
        },
        {
            "type": "gpu",
            "key": " {#36}│{#36} GPU         {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "gpu",
            "key": " {#36}│{#36} G Driver    {#36}│{$4}│{#keys} {$2}",
            "format": "{driver}"
        },
        {
            "type": "vulkan",
            "key": " {#36}│{#36} Vulkan      {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "board",
            "key": " {#36}│{#36} Motherboard {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "bios",
            "key": " {#36}│{#36} Bios        {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "custom",
            "key": " {#36}└─────────────┴{$1}┘{#keys} ",
            "format": ""
        },

        // Hardware section with cyan color theme
        {
            "type": "custom",
            "key": " {#36}┌─────────────┬{$1}┐{#keys} \u001b[37D",
            "format": ""
        },
        {
        "type": "memory",
        "key": " {#36}│{#36} RAM         {#36}│{$4}│{#keys} {$2}",
        "keyColor": "34",
        "percent": {
        "type": 3, // 3 = show number + bar + percentage
        "green": 30, // <30% is green
        "yellow": 70 // 30-70% is yellow, >70% is red
        }
        },
        {
        "type": "swap",
        "key": " {#36}│{#36} SWAP        {#36}│{$4}│{#keys} {$2}",
        "keyColor": "34",
        "percent": {
        "type": 3,
        "green": 30,
        "yellow": 70
        }
        },
        {
        "type": "disk",
        "keyColor": "34",
        "key": " {#36}│{#36} Disk        {#36}│{$4}│{#keys} {$2}",
        "percent": {
        "type": 3,           // 3 = show number + bar + percentage
        "green": 30,         // Below 30% usage is green
        "yellow": 70         // 30-70% is yellow, >70% is red
        }
        },
        {
            "type": "custom",
            "key": " {#36}└─────────────┴{$1}┘{#keys} ",
            "format": ""
        },
        {
            "type": "custom",
            "key": " {#36}┌─────────────┬{$1}┐{#keys} \u001b[37D",
            "format": ""
        },
        {
            "type": "shell",
            "key": " {#36}│{#36} Shell       {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "terminal",
            "key": " {#36}│{#36} Terminal    {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "terminalfont",
            "key": " {#36}│{#36} Term Font   {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "terminaltheme",
            "key": " {#36}│{#36} Term Theme  {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "custom",
            "key": " {#36}└─────────────┴{$1}┘{#keys} ",
            "format": ""
        },
        {
            "type": "custom",
            "key": " {#36}┌─────────────┬{$1}┐{#keys} \u001b[37D",
            "format": ""
        },
        {
            "type": "theme",
            "key": " {#36}│{#36} Style (Qt)  {#36}│{$4}│{#keys} {$2}",
            "format": "{theme1}"
        },
        {
            "type": "theme",
            "key": " {#36}│{#36} Style (GTK) {#36}│{$4}│{#keys} {$2}",
            "format": "{theme2}"
        },
        {
            "type": "wmtheme",
            "key": " {#36}│{#36} Decor       {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "icons",
            "key": " {#36}│{#36} Icons       {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "cursor",
            "key": " {#36}│{#36} Cursors     {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "font",
            "key": " {#36}│{#36} System Font {#36}│{$4}│{#keys} {$2}",
            "format": "{1}"
        },
        {
            "type": "custom",
            "key": " {#36}└─────────────┴{$1}┘{#keys} ",
            "format": ""
        },
        {
            "type": "custom",
            "key": " {#36}┌─────────────┬{$1}┐{#keys} \u001b[37D",
            "format": ""
        },
        {
            "type": "uptime",
            "key": " {#36}│{#36} Uptime Funk {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "users",
            "myselfOnly": true,                               // Only show current user
            "key": " {#36}│{#36} Login       {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "disk",
            "key": " {#36}│{#36} OS Age      {#36}│{$4}│{#keys} {$2}",
            "folders": "/",                                   // Check root filesystem
            "format": "{create-time:10} [{days} days]"        // Show creation time and age in days
        },
        {
            "type": "datetime",
            "key": " {#36}│{#36} Fetched     {#36}│{$4}│{#keys} {$2}",
            "format": "{day-pretty}-{month-pretty}-{year} {hour-pretty}:{minute-pretty}:{second-pretty} {timezone-name}"
        },
        {
            "type": "version",
            "key": " {#36}│{#36} FF Version  {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "custom",
            "key": " {#36}└─────────────┴{$1}┘{#keys} ",
            "format": ""
        },
        {
            "type": "custom",
            "key": " {#36}┌─────────────┬{$1}┐{#keys}\u001b[37D",
            "format": ""
        },
        {
            "type": "wifi",
            "key": " {#36}│{#36} Interweb    {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "bluetooth",
            "key": " {#36}│{#36} Bluetooth   {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "custom",
            "key": " {#36}└─────────────┴{$1}┘{#keys} ",
            "format": ""
        },
        {
            "type": "custom",
            "key": " {#36}┌─────────────┬{$1}┐{#keys}\u001b[37D",
            "format": ""
        },
        {
            "type": "sound",
            "key": " {#36}│{#36} Sound       {#36}│{$4}│{#keys} {$2}",
            "format": "{name:43} ({3})"
        },
        {
            "type": "camera",
            "key": " {#36}│{#36} Webcam      {#36}│{$4}│{#keys} {$2}"
        },
        {
            "type": "custom",
            "key": " {#36}└─────────────┴{$1}┘{#keys} ",
            "format": ""
        },
        "break",
        {
            "type": "custom",
            "key": "                          {#31} 󰅶 {#32} 󰅶 {#33} 󰅶 {#34} 󰅶 {#35} 󰅶 {#36} 󰅶 {#37} 󰅶 "
       }
    ]
}
